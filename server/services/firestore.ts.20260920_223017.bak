import * as admin from 'firebase-admin';
import type { Firestore } from 'firebase-admin/firestore';
import * as fs from 'fs';
import * as path from 'path';
import type { ClinicalCase } from '../../src/types/clinical';

let db: Firestore | null = null;
const inMemoryCases = new Map<string, ClinicalCase>();

/**
 * Resolve the Firestore database ID. The admin SDK defaults to "(default)";
 * the local firebase-applet-config.json may name a custom database.
 */
function resolveDatabaseId(): string | undefined {
  try {
    const configPath = path.resolve(process.cwd(), 'firebase-applet-config.json');
    if (fs.existsSync(configPath)) {
      const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
      return config.firestoreDatabaseId || undefined;
    }
  } catch {
    /* ignore */
  }
  return undefined;
}

/**
 * Initialize Firestore using the Firebase Admin SDK.
 *
 * Credential resolution order:
 *  1. FIREBASE_SERVICE_ACCOUNT_KEY (JSON string, injected by docker-compose /
 *     Cloud Run) — the production path.
 *  2. GOOGLE_APPLICATION_CREDENTIALS (path to a service-account JSON file).
 *  3. Application Default Credentials (works on GCP / Cloud Run automatically).
 *
 * If none are usable we fall back to in-memory persistence so the app still
 * runs in a local/dev sandbox without credentials.
 */
function initFirestore(): Firestore | null {
  if (db) return db;
  try {
    if (admin.apps.length === 0) {
      const serviceAccountJson = process.env.FIREBASE_SERVICE_ACCOUNT_KEY;
      if (serviceAccountJson) {
        const cred = JSON.parse(serviceAccountJson);
        admin.initializeApp({
          credential: admin.credential.cert(cred),
          projectId: cred.project_id || process.env.GOOGLE_CLOUD_PROJECT,
        });
        console.log('[Firestore] Initialized with FIREBASE_SERVICE_ACCOUNT_KEY');
      } else {
        // Falls back to GOOGLE_APPLICATION_CREDENTIALS or GCP metadata server.
        admin.initializeApp({
          credential: admin.credential.applicationDefault(),
          projectId: process.env.GOOGLE_CLOUD_PROJECT,
        });
        console.log('[Firestore] Initialized with application default credentials');
      }
    }
    db = admin.firestore();
    const dbId = resolveDatabaseId();
    if (dbId && dbId !== '(default)') {
      db = admin.firestore(undefined as never); // placeholder, replaced below
      // admin.firestore() with a custom database id:
      db = (admin.app().firestore() as Firestore);
    }
    return db;
  } catch (err) {
    console.warn(
      '[Firestore] Admin credentials unavailable; using in-memory persistence fallback.',
      (err as Error)?.message
    );
    return null;
  }
}

export async function saveCaseToFirestore(clinicalCase: ClinicalCase): Promise<void> {
  // Always update in-memory cache for ultra-responsive reads
  inMemoryCases.set(clinicalCase.id, clinicalCase);

  const firestore = initFirestore();
  if (!firestore) return;

  try {
    // Sanitize case for firestore (no undefined values)
    const sanitized = JSON.parse(JSON.stringify(clinicalCase));
    await firestore.collection('cases').doc(clinicalCase.id).set(sanitized, { merge: true });
  } catch (err) {
    console.error(`Error saving case ${clinicalCase.id} to Firestore:`, err);
  }
}

export async function getCaseFromFirestore(caseId: string): Promise<ClinicalCase | null> {
  const firestore = initFirestore();
  if (firestore) {
    try {
      const snap = await firestore.collection('cases').doc(caseId).get();
      if (snap.exists) {
        const data = snap.data() as ClinicalCase;
        inMemoryCases.set(caseId, data);
        return data;
      }
    } catch (err) {
      console.error(`Error reading case ${caseId} from Firestore:`, err);
    }
  }

  return inMemoryCases.get(caseId) || null;
}

export async function listCasesFromFirestore(maxResults = 25): Promise<ClinicalCase[]> {
  const firestore = initFirestore();
  const results: ClinicalCase[] = [];

  if (firestore) {
    try {
      const snapshot = await firestore
        .collection('cases')
        .orderBy('createdAt', 'desc')
        .limit(maxResults)
        .get();
      snapshot.forEach((docSnap) => {
        results.push(docSnap.data() as ClinicalCase);
      });
    } catch (err) {
      console.warn('Firestore list query failed, combining with in-memory cases:', err);
    }
  }

  // Merge in-memory cases
  for (const [id, c] of inMemoryCases.entries()) {
    if (!results.some((r) => r.id === id)) {
      results.push(c);
    }
  }

  // Sort descending by createdAt
  results.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
  return results.slice(0, maxResults);
}

export async function deleteCaseFromFirestore(caseId: string): Promise<void> {
  inMemoryCases.delete(caseId);
  const firestore = initFirestore();
  if (!firestore) return;
  try {
    await firestore.collection('cases').doc(caseId).delete();
  } catch (err) {
    console.error(`Error deleting case ${caseId}:`, err);
  }
}
