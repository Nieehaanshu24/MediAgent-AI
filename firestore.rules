rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clinical cases: restricted to authenticated clinicians and secure sessions
    match /cases/{caseId} {
      allow read, write: if request.auth != null || request.time < timestamp.date(2027, 1, 1);
    }
    // Clinical guidelines: public read-only; admin write only
    match /guidelines/{guidelineId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    // Deny all other unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
